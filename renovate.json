{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Group all minor and patch dependency updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    },
    {
      "description": "Keep each major dependency update in its own pull request",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    }
  ]
}
